+static void
+babel_reconfigure_hysteresis_(struct babel_proto *p, struct fib *rtable,
+                              struct babel_config *old, struct babel_config *new)
+{
+  struct fib_iterator fit;
+  btime now_ = current_time();
+
+  FIB_ITERATE_INIT(&fit, rtable);
+loop:
+  FIB_ITERATE_START(rtable, &fit, struct babel_entry, e)
+  {
+    struct babel_route *r;
+
+    if (old->hysteresis != new->hysteresis)
+      e->hysteresis_pending = 0;
+
+    WALK_LIST(r, e->routes)
+    {
+      if (old->hysteresis && new->hysteresis && r->smoothed_valid)
