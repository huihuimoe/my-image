+static void
+babel_smooth_route(struct babel_route *r, btime tau, btime now_)
+{
+  u32 target = (u32) r->metric << BABEL_SMOOTH_SHIFT;
+
+  if (!r->smoothed_valid)
+  {
+    r->smoothed_metric = target;
+    r->smoothed_at = now_;
+    r->smoothed_valid = 1;
+    return;
+  }
+
+  if (r->smoothed_metric == target)
+  {
+    r->smoothed_at = now_;
+    return;
+  }
+
+  btime elapsed = now_ - r->smoothed_at;
+  if (elapsed <= 0)
+    return;
+
+  u64 whole = elapsed / tau;
+  if (whole >= 32)
+  {
+    r->smoothed_metric = target;
+    r->smoothed_at = now_;
+    return;
+  }
+
+  u64 remainder = elapsed % tau;
+  u64 divisor = tau;
+  while (divisor > (UINT64_MAX >> 24))
+  {
+    divisor >>= 1;
+    remainder >>= 1;
+  }
+
+  u64 x = (whole << 24) + ((remainder << 24) / divisor);
+  u64 denom = (1ULL << 24) + (x >> 6);
+  u64 decay = (1ULL << 56) / denom;
+
+  /* Approximate exp(-elapsed/tau) as (1 + elapsed/(64*tau))^-64. */
+  if (decay == (1ULL << 32))
+    return;
+  for (uint i = 0; i < 6; i++)
+    decay = (decay * decay) >> 32;
+
+  s64 diff = (s64) target - r->smoothed_metric;
+  u64 magnitude = (diff < 0) ? -diff : diff;
+  u32 change = (magnitude * ((1ULL << 32) - decay)) >> 32;
+
+  /* Keep fractional elapsed time when the fixed-point value cannot move yet. */
+  if (!change)
+    return;
+
+  if (diff < 0)
+    r->smoothed_metric -= change;
+  else
+    r->smoothed_metric += change;
+  r->smoothed_at = now_;
+}
+
+static inline void
+babel_smooth_before_change(struct babel_config *cf, struct babel_route *r, btime now_)
+{
+  if (cf->hysteresis && r->smoothed_valid)
+  {
+    babel_smooth_route(r, cf->hysteresis_time, now_);
+    r->smoothed_at = now_;
+  }
+}
+
+static inline void
+babel_smooth_after_change(struct babel_config *cf, struct babel_route *r, btime now_)
+{
+  if (!cf->hysteresis)
+    return;
+
+  if ((r->metric == BABEL_INFINITY) || !r->feasible)
+    r->smoothed_valid = 0;
+  else if (!r->smoothed_valid)
+    babel_smooth_route(r, cf->hysteresis_time, now_);
+}
+
+static int
+babel_hysteresis_due(struct babel_proto *p, struct babel_entry *e)
+{
+  struct babel_config *cf = (void *) p->p.cf;
+  struct babel_route *selected = e->selected, *r;
+  btime now_ = current_time();
+
+  e->hysteresis_pending = 0;
+  if (!selected || (selected->metric == BABEL_INFINITY) || !selected->feasible)
+    return 1;
+
+  babel_smooth_route(selected, cf->hysteresis_time, now_);
+  WALK_LIST(r, e->routes)
+  {
+    if ((r == selected) || (r->metric >= selected->metric))
+      continue;
+
+    if (!babel_route_feasible(e, r))
+    {
+      r->smoothed_valid = 0;
+      continue;
+    }
+
+    babel_smooth_route(r, cf->hysteresis_time, now_);
+    if (r->smoothed_metric < selected->smoothed_metric)
+      return 1;
+    e->hysteresis_pending = 1;
+  }
+
+  return 0;
+}
