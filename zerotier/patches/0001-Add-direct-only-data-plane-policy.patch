+void Switch::_probeDirectPath(void* tPtr, const SharedPtr<Peer>& peer, uint64_t nwid, int64_t now, int32_t flowId)
+{
+	const SharedPtr<Peer> relay(RR->topology->getUpstreamPeer(nwid));
+	if (relay && relay->address() != peer->address()) {
+		const SharedPtr<Path> relayPath(relay->getAppropriatePath(now, false, flowId));
+		if (relayPath && _shouldUnite(now, RR->identity.address(), peer->address())) {
+			// A relayed HELLO prompts the upstream to introduce both peers.
+			peer->attemptToContactAt(tPtr, relayPath->localSocket(), relayPath->address(), now, true);
+		}
+	}
+}
