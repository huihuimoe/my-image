 			out["versionRev"] = ZEROTIER_ONE_VERSION_REVISION;
@@ -2877,19 +2921,44 @@ class OneServiceImpl : public OneService {
 			}
 		}
 
+		const bool directDataOnly = OSUtils::jsonBool(settings["directDataOnly"], false);
+		const bool wasDirectDataOnly = _node->directDataOnly();
+		_node->setDirectDataOnly(directDataOnly);
+		std::unique_lock<std::recursive_mutex> fallbackLock(_tcpFallback_m);
+
 		// bondingPolicy cannot be used with allowTcpFallbackRelay
 		bool _forceTcpRelayTmp = (OSUtils::jsonBool(settings["forceTcpRelay"], false));
 		bool _bondInUse = _node->bondController()->inUse();
 		if (_forceTcpRelayTmp && _bondInUse) {
 			fprintf(stderr, "Warning: forceTcpRelay cannot be used with multipath. Disabling forceTcpRelay\n");
 		}
-		_allowTcpFallbackRelay = (OSUtils::jsonBool(settings["allowTcpFallbackRelay"], true) && ! _node->bondController()->inUse());
-		_forceTcpRelay = (_forceTcpRelayTmp && ! _node->bondController()->inUse());
-		_enableWebServer = (OSUtils::jsonBool(settings["enableWebServer"], false));
-
+		if (directDataOnly && _forceTcpRelayTmp) {
+			fprintf(stderr, "Warning: directDataOnly overrides forceTcpRelay; using UDP.\n");
+		}
+		if (directDataOnly && settings["allowTcpFallbackRelay"].is_boolean() && settings["allowTcpFallbackRelay"].get<bool>()) {
+			fprintf(stderr, "Warning: directDataOnly overrides allowTcpFallbackRelay.\n");
+		}
+		_allowTcpFallbackRelay = (OSUtils::jsonBool(settings["allowTcpFallbackRelay"], true) && ! _node->bondController()->inUse() && ! directDataOnly);
+		_forceTcpRelay = (_forceTcpRelayTmp && ! _node->bondController()->inUse() && ! directDataOnly);
 #ifdef ZT_TCP_FALLBACK_RELAY
 		_fallbackRelayAddress = InetAddress(OSUtils::jsonString(settings["tcpFallbackRelay"], ZT_TCP_FALLBACK_RELAY).c_str());
 #endif
+		if (directDataOnly && ! wasDirectDataOnly) {
+			std::vector<PhySocket*> tunnels;
+			{
+				Mutex::Lock _l(_tcpConnections_m);
+				for (TcpConnection* tc : _tcpConnections) {
+					if (tc->type == TcpConnection::TCP_TUNNEL_OUTGOING && tc->sock) {
+						tunnels.push_back(tc->sock);
+					}
+				}
+			}
+			for (PhySocket* sock : tunnels) {
+				_phy.close(sock);
+			}
+		}
+		fallbackLock.unlock();
+		_enableWebServer = (OSUtils::jsonBool(settings["enableWebServer"], false));
 		_primaryPort = (unsigned int)OSUtils::jsonInt(settings["primaryPort"], (uint64_t)_primaryPort) & 0xffff;
 		_allowSecondaryPort = OSUtils::jsonBool(settings["allowSecondaryPort"], true);
 		_secondaryPort = (unsigned int)OSUtils::jsonInt(settings["secondaryPort"], 0);
