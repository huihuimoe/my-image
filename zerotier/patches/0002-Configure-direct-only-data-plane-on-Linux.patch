+				{
+					std::lock_guard<std::recursive_mutex> fallbackLock(_tcpFallback_m);
+					if (! _forceTcpRelay && (_tcpFallbackTunnel) && ((now - _lastDirectReceiveFromGlobal) < (ZT_TCP_FALLBACK_AFTER / 2))) {
+						_phy.close(_tcpFallbackTunnel->sock);
+					}
 				}
 
