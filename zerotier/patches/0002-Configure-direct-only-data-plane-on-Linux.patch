+			}
 			tc->lastReceive = OSUtils::now();
 			switch (tc->type) {
 				case TcpConnection::TCP_UNCATEGORIZED_INCOMING:
@@ -3421,7 +3500,12 @@ class OneServiceImpl : public OneService {
 
