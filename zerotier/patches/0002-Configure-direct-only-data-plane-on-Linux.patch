-			while (! _tcpConnections.empty())
-				_phy.close((*_tcpConnections.begin())->sock);
+			for (;;) {
+				std::lock_guard<std::recursive_mutex> fallbackLock(_tcpFallback_m);
+				PhySocket* sock;
+				{
+					Mutex::Lock _l(_tcpConnections_m);
+					if (_tcpConnections.empty()) {
+						break;
+					}
+					sock = _tcpConnections.front()->sock;
+				}
+				_phy.close(sock);
+			}
 		}
 		catch (...) {
 		}
@@ -1987,7 +2031,7 @@ class OneServiceImpl : public OneService {
 					if (pl->peers[i].address == wantp) {
 						SharedPtr<Bond> bond = _node->bondController()->getBondByPeerId(wantp);
