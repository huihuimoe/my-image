+						lastLocalConfStat = result;
+						lastLocalConfStatValid = true;
+#else
 						int64_t mod_time = result.st_mtime * 1000;
-						if ((now - mod_time) <= ZT_LOCAL_CONF_FILE_CHECK_INTERVAL) {
+						const bool changed = (now - mod_time) <= ZT_LOCAL_CONF_FILE_CHECK_INTERVAL;
+#endif
+						if (changed) {
