+							result.st_size != lastLocalConfStat.st_size || result.st_mtim.tv_sec != lastLocalConfStat.st_mtim.tv_sec ||
+							result.st_mtim.tv_nsec != lastLocalConfStat.st_mtim.tv_nsec || result.st_ctim.tv_sec != lastLocalConfStat.st_ctim.tv_sec ||
