-							_peerToJson(out, &(pl->peers[i]), bond, (_tcpFallbackTunnel != (TcpConnection*)0));
+							_peerToJson(out, &(pl->peers[i]), bond, tcpFallbackActive());
 							setContent(req, res, out.dump());
