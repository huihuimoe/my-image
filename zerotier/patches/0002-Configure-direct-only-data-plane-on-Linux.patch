 			out["online"] = (bool)(status.online != 0);
-			out["tcpFallbackActive"] = (_tcpFallbackTunnel != (TcpConnection*)0);
+			out["tcpFallbackActive"] = tcpFallbackActive();
 			out["versionMajor"] = ZEROTIER_ONE_VERSION_MAJOR;
