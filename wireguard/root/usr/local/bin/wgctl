#!/usr/bin/env bash
set -euo pipefail
umask 077

CONFIG_DIR=/config/wg_confs
NFT_FILE=/config/nftables.conf
STATE_DIR=/run/wgctl
APPLIED_DIR=/config/.wgctl/applied
STAGING_DIR=$STATE_DIR/staging
NFT_RULES=$STATE_DIR/nft.rules

log() { printf '[wgctl] %s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2; }
die() { log "error: $*"; exit 1; }

valid_iface() {
  [[ $1 =~ ^[A-Za-z0-9_.-]{1,15}$ ]]
}

valid_table() {
  [[ $1 =~ ^[A-Za-z0-9_]{1,32}$ ]]
}

iface_of() {
  basename "$1" .conf
}

configs() {
  local f
  for f in "$CONFIG_DIR"/*.conf; do
    if [[ -f $f ]]; then
      printf '%s\n' "$f"
    fi
  done
}

setup_state() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$APPLIED_DIR" "$STAGING_DIR"
}

lock_state() {
  exec 9>"$STATE_DIR/lock"
  flock 9
}

# Do not leak the lock fd into wg-quick: its userspace fallback and PostUp
# commands can outlive this process and would otherwise keep the lock held.
wg_quick() {
  wg-quick "$@" 9>&-
}

is_up() {
  ip link show dev "$1" >/dev/null 2>&1
}

owner_mark() {
  printf 'wgctl:%s' "$(nft_table)"
}

is_managed() {
  [[ $(cat "/sys/class/net/$1/ifalias" 2>/dev/null) == "$(owner_mark)" ]]
}

validate_conf() {
  local conf=$1 iface
  iface=$(iface_of "$conf")
  if ! wg_quick strip "$conf" >/dev/null; then
    log "$iface: invalid WireGuard config"
    return 1
  fi
  if grep -qiE '^[[:space:]]*SaveConfig[[:space:]]*=[[:space:]]*true[[:space:]]*(#.*)?$' "$conf"; then
    log "$iface: SaveConfig = true is not supported"
    return 1
  fi
}

interface_section() {
  awk '
    /^[[:space:]]*\[/ { in_iface = (tolower($0) ~ /^[[:space:]]*\[interface\]/); next }
    in_iface
  ' "$1"
}

allowed_ips() {
  awk '
    { $0 = tolower($0) }
    /^[[:space:]]*\[/ { in_peer = ($0 ~ /^[[:space:]]*\[peer\]/); next }
    in_peer && /^[[:space:]]*allowedips[[:space:]]*=/ {
      v = $0
      sub(/^[^=]*=/, "", v)
      sub(/#.*/, "", v)
      gsub(/[[:space:]]/, "", v)
      n = split(v, a, ",")
      for (i = 1; i <= n; i++) if (a[i] != "") print a[i]
    }
  ' "$1" | LC_ALL=C sort -u
}

# Only routes wg-quick would never have added are safe to change without a
# restart: prefixes covered by the interface's own address route.
can_sync() {
  local old=$1 new=$2 iface=$3 table prefix proto
  [[ $(interface_section "$old") == "$(interface_section "$new")" ]] || return 1
  table=$(interface_section "$new" | awk -F= '
    { $0 = tolower($0); sub(/#.*/, "") }
    /^[[:space:]]*table[[:space:]]*=/ { v = $2; gsub(/[[:space:]]/, "", v); print v; exit }
  ')
  [[ $table != off ]] || return 0
  while IFS= read -r prefix; do
    [[ -n $prefix ]] || continue
    [[ -z $table || $table == auto ]] || return 1
    [[ $prefix != */0 ]] || return 1
    proto=-4
    [[ $prefix != *:* ]] || proto=-6
    [[ -n $(ip "$proto" route show dev "$iface" proto kernel match "$prefix" 2>/dev/null) ]] || return 1
  done < <(LC_ALL=C comm -3 <(allowed_ips "$old") <(allowed_ips "$new") | tr -d '\t')
}

warn_default_route() {
  local conf=$1
  if grep -qiE '^[[:space:]]*AllowedIPs[[:space:]]*=[^#]*(0\.0\.0\.0/0|::/0)' "$conf"; then
    log "warning: $conf installs a default route in the current network namespace (the host with --net host)"
  fi
}

# wg-quick calls resolvconf when a config has a DNS line. Docker's resolv.conf
# was not written by openresolv, so adopt it first and keep a persistent copy
# for container restarts. This only touches the container's /etc/resolv.conf.
prepare_resolvconf() {
  local conf=$1
  grep -qiE '^[[:space:]]*DNS[[:space:]]*=' "$conf" || return 0

  local current=/etc/resolv.conf
  local backup=/config/.wgctl-resolv.conf
  local seed=""
  if [[ -f $current ]] && ! head -n1 "$current" 2>/dev/null | grep -qx '# Generated by resolvconf'; then
    seed=$current
    cp "$current" "$backup" 2>/dev/null || true
  elif [[ -f $backup ]]; then
    seed=$backup
  elif [[ -f /etc/resolv.conf.bak ]]; then
    seed=/etc/resolv.conf.bak
  fi

  mkdir -p /run/resolvconf/keys
  if [[ -n $seed && ! -f /run/resolvconf/keys/docker ]]; then
    cp "$seed" /run/resolvconf/keys/docker
  fi
  if ! resolvconf -u >/dev/null 2>&1; then
    log "warning: failed to initialize resolvconf for $conf"
    return 1
  fi
}

nft_table() {
  printf '%s' "${WG_NFT_TABLE:-wgctl}"
}

build_nft_rules() {
  local table=$1
  {
    echo "table inet $table {}"
    echo "delete table inet $table"
    echo "table inet $table {"
    cat "$NFT_FILE"
    echo
    echo "}"
  } > "$NFT_RULES"
}

validate_nft() {
  local table
  table=$(nft_table)
  valid_table "$table" || die "invalid WG_NFT_TABLE='$table'"

  rm -f "$NFT_RULES"
  [[ -f $NFT_FILE ]] || return 0

  build_nft_rules "$table"
  if ! nft -c -f "$NFT_RULES" >/dev/null; then
    log "invalid nftables file: $NFT_FILE"
    rm -f "$NFT_RULES"
    return 1
  fi
}

delete_nft_table() {
  local table
  table=$(nft_table)
  valid_table "$table" || die "invalid WG_NFT_TABLE='$table'"
  nft delete table inet "$table" 2>/dev/null || true
}

apply_nft() {
  local table
  table=$(nft_table)
  if [[ ! -f $NFT_RULES ]]; then
    log "nft: $NFT_FILE not found; removing table inet $table"
    delete_nft_table
    return 0
  fi

  if ! nft -f "$NFT_RULES"; then
    rm -f "$NFT_RULES"
    log "nft: failed to apply $NFT_FILE"
    return 1
  fi
  rm -f "$NFT_RULES"
  log "nft: applied table inet $table from $NFT_FILE"
}

start_one() {
  local src=$1 iface applied
  iface=$(iface_of "$src")
  applied=$APPLIED_DIR/$iface.conf
  if ! cp -f "$src" "$applied"; then
    log "$iface: failed to record state"
    return 1
  fi

  warn_default_route "$applied"
  if ! prepare_resolvconf "$applied"; then
    log "$iface: refusing to start because DNS setup failed"
    rm -f "$applied"
    return 1
  fi
  log "$iface: starting"
  if ! wg_quick up "$applied"; then
    log "$iface: failed to start"
    down_one "$iface" 1 || true
    return 1
  fi
  if ! is_up "$iface"; then
    log "$iface: wg-quick returned success but the interface is missing"
    down_one "$iface" 1 || true
    return 1
  fi
  if ! ip link set dev "$iface" alias "$(owner_mark)"; then
    log "$iface: failed to mark the interface; stopping"
    wg_quick down "$applied" || ip link del dev "$iface" 2>/dev/null || true
    rm -f "$applied"
    return 1
  fi
}

sync_one() {
  local src=$1 iface
  iface=$(iface_of "$src")
  log "$iface: only peers changed; syncing without restart"
  if ! wg syncconf "$iface" <(wg_quick strip "$src"); then
    log "$iface: wg syncconf failed"
    return 1
  fi
  if ! cp -f "$src" "$APPLIED_DIR/$iface.conf"; then
    log "$iface: failed to record state"
    return 1
  fi
}

restart_one() {
  local src=$1 iface prev_dir
  iface=$(iface_of "$src")
  prev_dir=$STATE_DIR/previous
  rm -rf "$prev_dir"
  if is_managed "$iface" && [[ -f $APPLIED_DIR/$iface.conf ]]; then
    if ! mkdir -p "$prev_dir" || ! cp -f "$APPLIED_DIR/$iface.conf" "$prev_dir/$iface.conf"; then
      log "$iface: failed to back up the applied config; not restarting"
      return 1
    fi
  fi
  log "$iface: restarting"
  if ! down_one "$iface" 1; then
    rm -rf "$prev_dir"
    return 1
  fi
  if start_one "$src"; then
    rm -rf "$prev_dir"
    return 0
  fi
  if [[ -f $prev_dir/$iface.conf ]]; then
    log "$iface: new config failed; restoring the previous config"
    start_one "$prev_dir/$iface.conf" || log "$iface: failed to restore the previous config"
  fi
  rm -rf "$prev_dir"
  return 1
}

apply_one() {
  local conf=$1 mode=$2 force=${3:-0}
  local iface staged applied
  iface=$(iface_of "$conf")
  staged=$STAGING_DIR/$iface.conf
  applied=$APPLIED_DIR/$iface.conf
  if ! cp -f "$conf" "$staged"; then
    log "$iface: failed to read $conf"
    return 1
  fi
  validate_conf "$staged" || return 1

  if ! is_up "$iface"; then
    start_one "$staged"
    return
  fi
  if [[ $force -eq 1 ]]; then
    restart_one "$staged"
  elif ! is_managed "$iface"; then
    log "$iface: exists but is not managed by this container; refusing to touch it (use --force)"
    return 1
  elif [[ -f $applied ]] && cmp -s "$applied" "$staged"; then
    log "$iface: unchanged"
  elif [[ $mode == up ]]; then
    log "$iface: config changed; run 'wgctl reload' to apply it"
  elif [[ -f $applied ]] && can_sync "$applied" "$staged" "$iface"; then
    sync_one "$staged"
  else
    restart_one "$staged"
  fi
}

down_one() {
  local iface=$1 force=${2:-0}
  local conf=$APPLIED_DIR/$iface.conf
  valid_iface "$iface" || die "invalid interface name: $iface"
  if ! is_up "$iface"; then
    rm -f "$conf"
    return 0
  fi
  if is_managed "$iface"; then
    log "$iface: stopping"
    if [[ ! -f $conf ]]; then
      log "$iface: applied config is missing; deleting the link"
      ip link del dev "$iface" 2>/dev/null || true
    elif ! wg_quick down "$conf"; then
      log "$iface: wg-quick down failed; deleting the link"
      ip link del dev "$iface" 2>/dev/null || true
    fi
  elif [[ $force -eq 0 ]]; then
    rm -f "$conf"
    log "$iface: exists but is not managed by this container; refusing to touch it (use --force)"
    return 1
  elif ! wg show "$iface" >/dev/null 2>&1; then
    log "$iface: exists but is not a WireGuard interface; refusing to delete it"
    return 1
  else
    log "$iface: not managed by this container; deleting the link"
    ip link del dev "$iface" 2>/dev/null || true
  fi
  nft delete table ip "wg-quick-$iface" 2>/dev/null || true
  nft delete table ip6 "wg-quick-$iface" 2>/dev/null || true
  rm -f "$conf"
}

mutate() {
  local mode=$1
  shift
  local force=0
  local -a targets=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --force)
        force=1
        shift
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        targets+=("$1")
        shift
        ;;
    esac
  done

  setup_state
  lock_state

  # Validate nftables first: a bad file must not change any interface.
  validate_nft

  local -a confs=()
  local t name
  if [[ ${#targets[@]} -gt 0 ]]; then
    for t in "${targets[@]}"; do
      name=${t%.conf}
      valid_iface "$name" || die "invalid interface name: $t"
      [[ -f $CONFIG_DIR/$name.conf ]] || die "no such config: $CONFIG_DIR/$name.conf"
      confs+=("$CONFIG_DIR/$name.conf")
    done
  else
    mapfile -t confs < <(configs)
  fi

  if [[ ${#confs[@]} -eq 0 ]]; then
    log "no WireGuard configs found in $CONFIG_DIR"
  fi
  local rc=0
  if [[ $mode == reload && ${#targets[@]} -eq 0 ]]; then
    local applied iface
    local -A wanted=()
    for t in "${confs[@]}"; do
      wanted[$(iface_of "$t")]=1
    done
    for applied in "$APPLIED_DIR"/*.conf; do
      [[ -e $applied ]] || continue
      iface=$(iface_of "$applied")
      if [[ -z ${wanted[$iface]:-} ]]; then
        log "$iface: config removed; stopping"
        down_one "$iface" || rc=1
      fi
    done
  fi

  for t in "${confs[@]}"; do
    name=$(iface_of "$t")
    if ! valid_iface "$name"; then
      log "invalid interface name '$name' (max 15 characters); skipping $t"
      rc=1
    else
      apply_one "$t" "$mode" "$force" || rc=1
    fi
  done

  if ! apply_nft; then
    log "$mode: nftables update failed"
    return 1
  fi
  return "$rc"
}

cmd_down() {
  local force=0
  local -a raw_targets=()
  local t name f i
  while [[ $# -gt 0 ]]; do
    case $1 in
      --force)
        force=1
        shift
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        raw_targets+=("$1")
        shift
        ;;
    esac
  done

  setup_state
  lock_state

  local -a ifaces=()
  if [[ ${#raw_targets[@]} -gt 0 ]]; then
    for t in "${raw_targets[@]}"; do
      name=${t%.conf}
      valid_iface "$name" || die "invalid interface name: $t"
      ifaces+=("$name")
    done
  else
    local -A seen=()
    for f in "$APPLIED_DIR"/*.conf "$CONFIG_DIR"/*.conf; do
      [[ -f $f ]] || continue
      i=$(iface_of "$f")
      valid_iface "$i" || continue
      if [[ -z ${seen[$i]:-} ]]; then
        seen[$i]=1
        ifaces+=("$i")
      fi
    done
  fi

  local rc=0
  for i in "${ifaces[@]}"; do
    down_one "$i" "$force" || rc=1
  done
  if ! compgen -G "$APPLIED_DIR/*.conf" >/dev/null; then
    delete_nft_table
  fi
  return "$rc"
}

cmd_status() {
  [[ $# -eq 0 ]] || die "status takes no arguments"
  local interfaces
  interfaces=$(wg show interfaces 2>/dev/null || true)
  if [[ -z $interfaces ]]; then
    log "no active WireGuard interfaces"
  else
    printf 'interfaces: %s\n' "$interfaces"
    wg show all || true
  fi
  local table
  table=$(nft_table)
  if nft list table inet "$table" >/dev/null 2>&1; then
    printf 'nft: table inet %s present\n' "$table"
  else
    printf 'nft: table inet %s absent\n' "$table"
  fi
}

usage() {
  cat <<'EOF'
wgctl - manage WireGuard configs and nftables in this container

Usage: wgctl <command> [options] [interface...]

Commands:
  up [--force] [iface...]       Start missing interfaces (default: all)
  reload [--force] [iface...]   Apply changed/new/removed configs
  down [--force] [iface...]     Stop interfaces (default: all managed)
  status                        Show WireGuard and nftables state
  help                          Show this help

Options:
  --force                       Restart, or take over an interface not created here

Files:
  /config/wg_confs/*.conf       wg-quick configs (source of truth)
  /config/nftables.conf         contents of table inet wgctl (optional)
  WG_NFT_TABLE                  nftables table name (default: wgctl)

There is no config, peer, or key generation.
EOF
}

main() {
  local command=${1:-help}
  shift || true
  case $command in
    up) mutate up "$@" ;;
    reload) mutate reload "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    help|-h|--help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
